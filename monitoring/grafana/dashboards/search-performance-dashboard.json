{
  "dashboard": {
    "id": null,
    "uid": "search-performance-complete",
    "title": "🔍 Search API Performance - Complete Analysis",
    "tags": ["search", "performance", "latency", "throughput", "before-after", "index-comparison"],
    "style": "dark",
    "timezone": "browser",
    "refresh": "5s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "templating": {
      "list": [
        {
          "name": "testType",
          "type": "custom",
          "query": "before-index,after-index",
          "current": {
            "value": "after-index",
            "text": "after-index"
          },
          "options": [
            {"text": "Before Index", "value": "before-index"},
            {"text": "After Index", "value": "after-index"}
          ]
        },
        {
          "name": "threads",
          "type": "custom", 
          "query": "1,10,100,1000",
          "current": {
            "value": "100",
            "text": "100"
          },
          "options": [
            {"text": "1 Thread", "value": "1"},
            {"text": "10 Threads", "value": "10"},
            {"text": "100 Threads", "value": "100"},
            {"text": "1000 Threads", "value": "1000"}
          ]
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "🚀 Current Throughput (RPS)",
        "type": "stat",
        "targets": [
          {
            "query": "SELECT last(\"count\") FROM \"jmeter\" WHERE $timeFilter AND \"transaction\" = 'Search Users'",
            "refId": "A",
            "datasource": "InfluxDB"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds",
              "thresholds": {
                "steps": [
                  {"color": "red", "value": 0},
                  {"color": "yellow", "value": 10},
                  {"color": "green", "value": 50}
                ]
              }
            },
            "unit": "reqps",
            "decimals": 1
          }
        },
        "gridPos": {"h": 6, "w": 4, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "⏱️ Average Response Time",
        "type": "stat",
        "targets": [
          {
            "query": "SELECT last(\"avg\") FROM \"jmeter\" WHERE $timeFilter AND \"transaction\" = 'Search Users'",
            "refId": "A",
            "datasource": "InfluxDB"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds",
              "thresholds": {
                "steps": [
                  {"color": "green", "value": 0},
                  {"color": "yellow", "value": 100},
                  {"color": "orange", "value": 500},
                  {"color": "red", "value": 1000}
                ]
              }
            },
            "unit": "ms",
            "decimals": 0
          }
        },
        "gridPos": {"h": 6, "w": 4, "x": 4, "y": 0}
      },
      {
        "id": 3,
        "title": "🎯 95th Percentile",
        "type": "stat",
        "targets": [
          {
            "query": "SELECT last(\"pct95.0\") FROM \"jmeter\" WHERE $timeFilter AND \"transaction\" = 'Search Users'",
            "refId": "A",
            "datasource": "InfluxDB"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds",
              "thresholds": {
                "steps": [
                  {"color": "green", "value": 0},
                  {"color": "yellow", "value": 200},
                  {"color": "orange", "value": 1000},
                  {"color": "red", "value": 2000}
                ]
              }
            },
            "unit": "ms",
            "decimals": 0
          }
        },
        "gridPos": {"h": 6, "w": 4, "x": 8, "y": 0}
      },
      {
        "id": 4,
        "title": "❌ Error Rate",
        "type": "stat",
        "targets": [
          {
            "query": "SELECT last(\"errorPct\") FROM \"jmeter\" WHERE $timeFilter AND \"transaction\" = 'Search Users'",
            "refId": "A",
            "datasource": "InfluxDB"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds",
              "thresholds": {
                "steps": [
                  {"color": "green", "value": 0},
                  {"color": "yellow", "value": 1},
                  {"color": "red", "value": 5}
                ]
              }
            },
            "unit": "percent",
            "decimals": 2
          }
        },
        "gridPos": {"h": 6, "w": 4, "x": 12, "y": 0}
      },
      {
        "id": 5,
        "title": "👥 Active Threads",
        "type": "stat",
        "targets": [
          {
            "query": "SELECT last(\"allThreads\") FROM \"jmeter\" WHERE $timeFilter AND \"transaction\" = 'Search Users'",
            "refId": "A",
            "datasource": "InfluxDB"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds",
              "thresholds": {
                "steps": [
                  {"color": "blue", "value": 0},
                  {"color": "green", "value": 10},
                  {"color": "yellow", "value": 100},
                  {"color": "red", "value": 500}
                ]
              }
            },
            "unit": "short",
            "decimals": 0
          }
        },
        "gridPos": {"h": 6, "w": 4, "x": 16, "y": 0}
      },
      {
        "id": 6,
        "title": "✅ Success Rate",
        "type": "stat",
        "targets": [
          {
            "query": "SELECT last(100 - \"errorPct\") FROM \"jmeter\" WHERE $timeFilter AND \"transaction\" = 'Search Users'",
            "refId": "A",
            "datasource": "InfluxDB"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds",
              "thresholds": {
                "steps": [
                  {"color": "red", "value": 0},
                  {"color": "yellow", "value": 95},
                  {"color": "green", "value": 99}
                ]
              }
            },
            "unit": "percent",
            "decimals": 1
          }
        },
        "gridPos": {"h": 6, "w": 4, "x": 20, "y": 0}
      },
      {
        "id": 7,
        "title": "📈 Throughput Over Time (Requests/sec)",
        "type": "timeseries",
        "targets": [
          {
            "query": "SELECT mean(\"count\") AS \"RPS\" FROM \"jmeter\" WHERE $timeFilter AND \"transaction\" = 'Search Users' GROUP BY time($__interval) fill(null)",
            "refId": "A",
            "datasource": "InfluxDB"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "reqps"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6}
      },
      {
        "id": 8,
        "title": "⏱️ Response Time Distribution",
        "type": "timeseries",
        "targets": [
          {
            "query": "SELECT mean(\"min\") AS \"Min\", mean(\"avg\") AS \"Average\", mean(\"pct50.0\") AS \"Median (50%)\", mean(\"pct90.0\") AS \"90th Percentile\", mean(\"pct95.0\") AS \"95th Percentile\", mean(\"pct99.0\") AS \"99th Percentile\", mean(\"max\") AS \"Max\" FROM \"jmeter\" WHERE $timeFilter AND \"transaction\" = 'Search Users' GROUP BY time($__interval) fill(null)",
            "refId": "A",
            "datasource": "InfluxDB"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "ms"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6}
      },
      {
        "id": 9,
        "title": "🔄 Active Threads Over Time",
        "type": "timeseries",
        "targets": [
          {
            "query": "SELECT mean(\"allThreads\") AS \"Active Threads\" FROM \"jmeter\" WHERE $timeFilter AND \"transaction\" = 'Search Users' GROUP BY time($__interval) fill(null)",
            "refId": "A",
            "datasource": "InfluxDB"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "short"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14}
      },
      {
        "id": 10,
        "title": "❌ Error Rate Over Time",
        "type": "timeseries",
        "targets": [
          {
            "query": "SELECT mean(\"errorPct\") AS \"Error %\" FROM \"jmeter\" WHERE $timeFilter AND \"transaction\" = 'Search Users' GROUP BY time($__interval) fill(null)",
            "refId": "A",
            "datasource": "InfluxDB"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "percent"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14}
      },
      {
        "id": 11,
        "title": "📊 Response Time Histogram",
        "type": "histogram",
        "targets": [
          {
            "query": "SELECT \"min\", \"pct25.0\", \"pct50.0\", \"pct75.0\", \"pct90.0\", \"pct95.0\", \"pct99.0\", \"max\" FROM \"jmeter\" WHERE $timeFilter AND \"transaction\" = 'Search Users'",
            "refId": "A",
            "datasource": "InfluxDB"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "ms"
          }
        },
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 22}
      },
      {
        "id": 12,
        "title": "📋 Test Summary Table",
        "type": "table",
        "targets": [
          {
            "query": "SELECT time, \"count\" AS \"RPS\", \"avg\" AS \"Avg Response (ms)\", \"pct95.0\" AS \"95th % (ms)\", \"errorPct\" AS \"Error %\", \"allThreads\" AS \"Threads\" FROM \"jmeter\" WHERE $timeFilter AND \"transaction\" = 'Search Users' ORDER BY time DESC LIMIT 100",
            "refId": "A",
            "datasource": "InfluxDB"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "unit": "short"
          }
        },
        "gridPos": {"h": 10, "w": 24, "x": 0, "y": 30}
      }
    ],
    "annotations": {
      "list": [
        {
          "name": "Test Start",
          "datasource": "InfluxDB",
          "enable": true,
          "query": "SELECT \"testTitle\" FROM \"jmeter\" WHERE $timeFilter AND \"transaction\" = 'Search Users'",
          "textColumn": "testTitle",
          "iconColor": "rgba(0, 211, 255, 1)"
        }
      ]
    },
    "schemaVersion": 30,
    "version": 1
  }
} 